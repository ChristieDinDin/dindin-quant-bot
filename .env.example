# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# Environment
ENVIRONMENT=development  # development, production

# Data Provider
DATA_PROVIDER=yfinance  # yfinance, shioaji

# Database
DATABASE_PATH=data/database/market_data.db

# Shioaji Credentials (for Taiwan market real-time data)
# IMPORTANT: Never commit your real .env file to Git!
SHIOAJI_API_KEY=your_api_key_here
SHIOAJI_SECRET_KEY=your_secret_key_here
SHIOAJI_PERSON_ID=your_person_id_here  # Usually your ID card number
SHIOAJI_SIMULATION=true  # Set to false for real trading!

# Backtesting
INITIAL_CASH=1000000  # Initial capital in TWD
COMMISSION=0.001425   # Trading commission (0.1425%)

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/trading.log

# Strategy Parameters (optional overrides)
# MFI_PERIOD=16
# MFI_BUY_THRESHOLD=35
# MFI_SELL_THRESHOLD=85

# Alerts & Notifications (future)
# EMAIL_ALERTS=true
# ALERT_EMAIL=your.email@example.com
